# Zepit backend — local run configuration.
# Never commit a real token; STATUS.md open item: rotate the PAT before the repo goes public.

# Zerops Personal Access Token. Used for both `zcli login` and the REST API.
# On Zerops this MUST be named ZEPIT_ZEROPS_TOKEN — the `ZEROPS_` prefix is reserved
# and an import YAML using it is rejected outright. Both names work locally.
ZEROPS_TOKEN=

# Target project that deploys are imported into. Per-job hostname prefixes keep
# concurrent jobs from colliding inside it.
ZEROPS_PROJECT_ID=hhwmCH9nQ2uo77MnFRCAcg

# Zepit's own job database.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=zepit

PORT=3000

# Fallback archetype: used when no archetype is chosen and classification fails
# or is unconfigured. A broken LLM must never take the deploy path down with it.
ZEPIT_ARCHETYPE=realtime-chat

# Step 5: the archetype classifier. Set ONE of the keys below. Without either, the
# UI still works — you pick the archetype yourself and the LLM path is skipped.
#
# The provider is inferred from whichever key is present, and each brings its own
# default model. Set ZEPIT_LLM_PROVIDER only to break a tie when both are set.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ZEPIT_LLM_PROVIDER=gemini          # gemini | anthropic
# ZEPIT_LLM_MODEL=gemini-2.5-flash   # default: gemini-2.5-flash / claude-opus-5
# ZEPIT_LLM_EFFORT=low               # anthropic only
# ZEPIT_LLM_THINKING_BUDGET=0        # gemini only; 0 disables thinking on flash
# ZEPIT_LLM_TIMEOUT_MS=60000
